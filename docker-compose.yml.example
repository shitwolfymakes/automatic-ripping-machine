name: armv3

services:
  arm-db:
    image: postgres:18
    container_name: armv3-db
    restart: unless-stopped
    entrypoint:
      - bash
      - -c
      - |
        install -o postgres -g postgres -m 0600 /etc/ssl/arm/tls.key /tmp/pg.key
        install -o postgres -g postgres -m 0644 /etc/ssl/arm/tls.crt /tmp/pg.crt
        exec docker-entrypoint.sh postgres \
          -c ssl=on \
          -c ssl_cert_file=/tmp/pg.crt \
          -c ssl_key_file=/tmp/pg.key \
          -c ssl_ca_file=/etc/ssl/arm/arm-ca.crt
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    volumes:
      - ./arm/db:/var/lib/postgresql
      - ./arm/certs/arm-ca.crt:/etc/ssl/arm/arm-ca.crt:ro
      - ./arm/certs/arm-db.crt:/etc/ssl/arm/tls.crt:ro
      - ./arm/certs/arm-db.key:/etc/ssl/arm/tls.key:ro

  arm-backend:
    build: &backend-build
      context: .
      dockerfile: services/backend/Dockerfile
    container_name: armv3-backend
    restart: unless-stopped
    depends_on:
      arm-db:
        condition: service_started
      arm-data-init:
        condition: service_completed_successfully
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@arm-db:5432/${POSTGRES_DB}?sslmode=verify-full&sslrootcert=/etc/ssl/arm/arm-ca.crt
      ARM_SERVICE_TOKEN: ${ARM_SERVICE_TOKEN}
      ARM_LOG_LEVEL: ${ARM_LOG_LEVEL:-info}
      ARM_ALLOWED_ORIGINS: ${ARM_ALLOWED_ORIGINS:-}
      TLS_CERT_PATH: /etc/ssl/arm/tls.crt
      TLS_KEY_PATH: /etc/ssl/arm/tls.key
      PUID: ${PUID:-1000}
      PGID: ${PGID:-1000}
      # Phase 7 — transcode dispatcher needs host paths (the docker daemon
      # interprets these, NOT the Backend container's filesystem).
      MEDIA_ROOT: /media
      MAX_PARALLEL_TRANSCODES: ${MAX_PARALLEL_TRANSCODES:-1}
      ARM_TRANSCODE_IMAGE: ${ARM_TRANSCODE_IMAGE:-arm-transcode:latest}
      ARM_TRANSCODE_STALE_THRESHOLD_SECONDS: ${ARM_TRANSCODE_STALE_THRESHOLD_SECONDS:-90}
      ARM_TRANSCODE_MAX_ATTEMPTS: ${ARM_TRANSCODE_MAX_ATTEMPTS:-3}
      ARM_TRANSCODE_DISPATCH_INTERVAL_SECONDS: ${ARM_TRANSCODE_DISPATCH_INTERVAL_SECONDS:-5}
      ARM_NOTIFICATION_DISPATCH_INTERVAL_SECONDS: ${ARM_NOTIFICATION_DISPATCH_INTERVAL_SECONDS:-5}
      ARM_NOTIFY_IMAGE_URL: ${ARM_NOTIFY_IMAGE_URL:-}
      # Default to the same host paths the bind mounts below resolve to —
      # `${PWD}` is the directory `docker compose` was invoked from, which
      # for this project is always the repo root. Override in `.env` only if
      # you've moved the data out of the repo tree.
      ARM_HOST_RAW_PATH: ${ARM_HOST_RAW_PATH:-${PWD}/arm/raw}
      ARM_HOST_MEDIA_PATH: ${ARM_HOST_MEDIA_PATH:-${PWD}/arm/media}
      ARM_HOST_LOGS_PATH: ${ARM_HOST_LOGS_PATH:-${PWD}/arm/logs}
      ARM_HOST_CERTS_PATH: ${ARM_HOST_CERTS_PATH:-${PWD}/arm/certs}
      ARM_DOCKER_NETWORK: ${ARM_DOCKER_NETWORK:-armv3_default}
      # Drive lifecycle — the backend creates one ripper container per
      # enrolled drive (spec §3). Same PUID/PGID/CDROM_GID as every service.
      CDROM_GID: ${CDROM_GID:-44}
      ARM_RIPPER_IMAGE: ${ARM_RIPPER_IMAGE:-arm-ripper:latest}
      # Optional ripper tunables, forwarded verbatim into every ripper the
      # manager creates (empty = the ripper's own defaults). See .env.example.
      ARM_RIPPER_POLL_INTERVAL_SECONDS: ${ARM_RIPPER_POLL_INTERVAL_SECONDS:-}
      ARM_RIPPER_MIN_LENGTH_SECONDS: ${ARM_RIPPER_MIN_LENGTH_SECONDS:-}
      ARM_RIPPER_MAKEMKV_KEYCHECK_INTERVAL_SECONDS: ${ARM_RIPPER_MAKEMKV_KEYCHECK_INTERVAL_SECONDS:-}
      ARM_RIPPER_NOT_READY_REARM_POLLS: ${ARM_RIPPER_NOT_READY_REARM_POLLS:-}
      ARM_RIPPER_OPTICAL_SR_MAX: ${ARM_RIPPER_OPTICAL_SR_MAX:-}
      ARM_RIPPER_OPTICAL_SG_MAX: ${ARM_RIPPER_OPTICAL_SG_MAX:-}
      ARM_RIPPER_CERTS_PATH: ${ARM_RIPPER_CERTS_PATH:-}
      # Phase 7b — GPUs detected host-side by setup-dev.sh into ARM_GPUS. The
      # GPU-free backend reads this to fill the gpus table; the dispatcher
      # injects device access into each ephemeral transcoder. [] => CPU-only.
      ARM_GPUS: ${ARM_GPUS:-[]}
      ARM_RENDER_GID: ${ARM_RENDER_GID:-}
      # NOTE: setting these 4 keys by hand is NOT enough for remote offload —
      # the backend also needs an ssh key mounted at /home/arm/.ssh (ro).
      # install.sh adds that volume automatically; if you hand-copy this
      # compose file, add `./ssh:/home/arm/.ssh:ro` to arm-backend's volumes
      # yourself. See ARM_TRANSCODE_SSH_DIR in .env.example.
      ARM_TRANSCODE_DOCKER_HOST: ${ARM_TRANSCODE_DOCKER_HOST:-}
      ARM_TRANSCODE_BACKEND_URL: ${ARM_TRANSCODE_BACKEND_URL:-}
      ARM_TRANSCODE_PUID: ${ARM_TRANSCODE_PUID:-}
      ARM_TRANSCODE_PGID: ${ARM_TRANSCODE_PGID:-}
      # Ripper-only deployments: setup-dev.sh --ripper-only writes this false
      # in .env. See ARM_TRANSCODE_CAPABLE in .env.example.
      ARM_TRANSCODE_CAPABLE: ${ARM_TRANSCODE_CAPABLE:-true}
    volumes:
      - ./arm/logs:/logs
      - ./arm/media:/media
      - ./arm/raw:/raw
      # Bash hook scripts (Settings > Notifications > Bash script). Read-only:
      # the backend runs them, operators edit them on the host.
      - ./arm/scripts:/scripts:ro
      - ./arm/certs/arm-ca.crt:/etc/ssl/arm/arm-ca.crt:ro
      - ./arm/certs/arm-backend.crt:/etc/ssl/arm/tls.crt:ro
      - ./arm/certs/arm-backend.key:/etc/ssl/arm/tls.key:ro
      # Phase 7 — Backend spawns arm-transcode-* containers via the socket.
      # Acceptable per docs/arch/06-deployment.md (root-equivalent on host).
      - /var/run/docker.sock:/var/run/docker.sock
      # Drive detection (spec §2): the host's udev by-id symlink directory,
      # read-only. Symlinks only — no device nodes, no cgroup rule; the
      # backend can list drives but provably cannot open one.
      - /dev/disk:/host-disk:ro
      # Backend data that must survive recreates: the TheDiscDB snapshot
      # (/data/cache/thediscdb, re-downloaded from scratch without it) and
      # the poster image cache (/data/cache/images). The backend image seeds
      # /data owned 1000:1000 2775, and the arm-data-init service below
      # re-owns the volume to PUID:PGID before this container starts, so a
      # custom PGID, a PUID/PGID change, or a root-owned volume from an older
      # release needs no manual chown. The entrypoint's boot guard still
      # fails fast and names /data if it is somehow left unwritable.
      - arm-data:/data
    # Uncomment to reach Backend directly from the host for verification curl:
    # ports:
    #   - "8443:8443"

  # One-shot, root, before arm-backend: makes the arm-data named volume owned
  # by PUID:PGID. The backend's entrypoint only VERIFIES /data (it never
  # chowns), so this is what handles a PGID other than 1000, a PUID/PGID
  # change on an existing install, or a root-owned volume from an older
  # release. arm-data is an ARM-owned named volume, not a user bind mount, so
  # managing its ownership here does not break the never-chown invariant
  # (docs/arch/06-deployment.md). It reuses the backend's build (all layers
  # cached, nothing extra to pull) with the entrypoint replaced, so the shared
  # entrypoint's gosu drop and /data guard never run here. Owner already
  # right: logs and exits 0 without walking the tree. Otherwise: re-owns the
  # contents, makes them group-writable with setgid dirs, and re-owns /data
  # itself last, so /data's owner marks a completed run and an interrupted one
  # is retried on the next start. PUID or PGID 0 is refused. Any failure exits
  # non-zero and arm-backend does not start (service_completed_successfully).
  arm-data-init:
    build: *backend-build
    container_name: armv3-data-init
    user: "0:0"
    restart: "no"
    network_mode: none
    environment:
      PUID: ${PUID:-1000}
      PGID: ${PGID:-1000}
    entrypoint:
      - /bin/sh
      - -c
      - |
        set -eu
        puid="$${PUID:-1000}"
        pgid="$${PGID:-1000}"
        for id in "$$puid" "$$pgid"; do
          case "$$id" in
            ''|*[!0-9]*)
              echo "arm-data-init: FATAL: PUID and PGID must be numeric (got $$puid:$$pgid)" >&2
              exit 1 ;;
          esac
        done
        if [ "$$puid" -eq 0 ] || [ "$$pgid" -eq 0 ]; then
          echo "arm-data-init: FATAL: refusing PUID:PGID $$puid:$$pgid; never handing arm-data to uid or gid 0" >&2
          exit 1
        fi
        target="$$puid:$$pgid"
        cu="$$(stat -c '%u' /data)"
        cg="$$(stat -c '%g' /data)"
        if [ "$$cu" -eq "$$puid" ] && [ "$$cg" -eq "$$pgid" ]; then
          echo "arm-data-init: arm-data already owned by $$target"
          exit 0
        fi
        echo "arm-data-init: /data owned by $$cu:$$cg, re-owning to $$target"
        # /data's own owner is the commit marker: contents first, /data last,
        # so an interrupted or failed run leaves the old owner and the next
        # start retries the whole repair.
        find /data -mindepth 1 -exec chown -h "$$target" {} +
        find /data -mindepth 1 ! -type l -exec chmod g+rwX {} +
        find /data -mindepth 1 -type d -exec chmod g+s {} +
        chmod g+rwxs /data
        chown "$$target" /data
        echo "arm-data-init: arm-data now owned by $$target (group-writable, setgid dirs)"
    volumes:
      - arm-data:/data

  # The fat HW transcode image. `deploy.replicas: 0` means `docker compose up`
  # BUILDS it (so a plain `up -d --build` tags arm-transcode:latest) but starts
  # zero containers — the Backend dispatcher spawns short-lived transcoder
  # containers from this image per task via the docker socket. Don't give it a
  # profile: profiles would also exclude it from `up`/`build`, so the image
  # would never get built locally.
  arm-transcode:
    image: ${ARM_TRANSCODE_IMAGE:-arm-transcode:latest}
    build:
      context: .
      dockerfile: services/transcode/Dockerfile
    deploy:
      replicas: 0

  # The ripper image. Built here, never run here: the Backend's ripper manager
  # creates one durable `arm-ripper-<serial>` container per ENROLLED drive via
  # the docker socket (label arm.drive_id). Enroll drives from the UI's Drives
  # page — there is no install-time drive step. `deploy.replicas: 0` for the
  # same reason as arm-transcode (a profile would skip the build).
  arm-ripper:
    image: ${ARM_RIPPER_IMAGE:-arm-ripper:latest}
    build:
      context: .
      dockerfile: services/ripper/Dockerfile
    deploy:
      replicas: 0

  arm-ui:
    build:
      context: .
      dockerfile: services/ui/Dockerfile
    container_name: armv3-ui
    restart: unless-stopped
    depends_on:
      - arm-backend
    ports:
      - "8081:443"
    volumes:
      - ./arm/certs/arm-ca.crt:/etc/ssl/arm/arm-ca.crt:ro
      - ./arm/certs/arm-ui.crt:/etc/ssl/arm/tls.crt:ro
      - ./arm/certs/arm-ui.key:/etc/ssl/arm/tls.key:ro

  arm-ui-neu:
    build:
      context: .
      dockerfile: services/ui-neu/Dockerfile
    container_name: armv3-ui-neu
    restart: unless-stopped
    depends_on:
      - arm-backend
    ports:
      - "8082:443"
    volumes:
      - ./arm/certs/arm-ca.crt:/etc/ssl/arm/arm-ca.crt:ro
      - ./arm/certs/arm-ui.crt:/etc/ssl/arm/tls.crt:ro
      - ./arm/certs/arm-ui.key:/etc/ssl/arm/tls.key:ro

volumes:
  arm-data:
