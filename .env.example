POSTGRES_USER=arm
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24
POSTGRES_DB=arm

ARM_SERVICE_TOKEN=change-me-openssl-rand-hex-32

PUID=1000
PGID=1000
CDROM_GID=44

ARM_LOG_LEVEL=info

# Optional OMDB API key. When set, overrides config.omdb_api_key on every
# identify call (handy in dev — keep the secret out of the DB).
OMDB_API_KEY=

# Optional internal mirror for MakeMKV artifacts. Used at ripper build time
# (tarballs + signed sha file, passed as docker build args) and at container
# start (beta-key.txt, with forum scrape as fallback). Rides out makemkv.com
# outages and gives reproducible rebuilds after upstream deletes old tarballs.
# sdf.bin is also mirrored, but upstream-first: makemkv.com/.info are tried
# before the mirror, so a stale mirror never shadows a working upstream.
# Layout served by the mirror:
#   $MAKEMKV_MIRROR_URL/LATEST
#   $MAKEMKV_MIRROR_URL/<ver>/makemkv-sha-<ver>.txt
#   $MAKEMKV_MIRROR_URL/<ver>/makemkv-{oss,bin}-<ver>.tar.gz
#   $MAKEMKV_MIRROR_URL/beta-key.txt
#   $MAKEMKV_MIRROR_URL/sdf.bin
# MAKEMKV_MIRROR_PASSWORD (optional) is sent as an X-SHARE-PASSWORD header,
# matching Filebrowser password-protected shares. Artifacts are GPG + sha256
# verified against the pinned MakeMKV signing key either way, so the mirror
# itself needs zero trust.
MAKEMKV_MIRROR_URL=
MAKEMKV_MIRROR_PASSWORD=

# Comma-separated allowlist of `Origin` header values the WebSocket endpoint
# accepts from browser clients. Service-token connections (rippers /
# transcoders) skip this check via subprotocol marker. Add every URL the UI
# is reachable at — bare `localhost:8081` for the dev host, plus your LAN
# hostname / IP if you log in from another device.
ARM_ALLOWED_ORIGINS=https://localhost:8081

# Phase 7: transcode dispatcher.
#
# MAX_PARALLEL_TRANSCODES — how many transcoder containers may run at once.
# A 1080p HandBrake transcode pegs every CPU core; default 1 is conservative.
MAX_PARALLEL_TRANSCODES=1

# ARM_TRANSCODE_IMAGE (the fat multi-vendor HW image the dispatcher spawns per
# task) is intentionally NOT set here — docker-compose.yml defaults it to
# `arm-transcode:latest`, built locally by `docker compose up -d --build` (the
# arm-transcode service is deploy.replicas:0 — built, never run). Set it only to
# override the image explicitly.

# Backend's host-side mount paths. Required because the Backend spawns
# transcoder containers via the docker socket — the daemon resolves these
# host paths, not the Backend container's `/raw` etc. Compose substitutes
# `${PWD}` at parse time so these stay portable across checkouts.
ARM_HOST_RAW_PATH=${PWD}/arm/raw
ARM_HOST_MEDIA_PATH=${PWD}/arm/media
ARM_HOST_LOGS_PATH=${PWD}/arm/logs
ARM_HOST_CERTS_PATH=${PWD}/arm/certs

# Docker network the spawned transcoder joins so it can reach
# `https://arm-backend:8443`. Compose default is `<project>_default`;
# our project is named `armv3`.
ARM_DOCKER_NETWORK=armv3_default

# Phase 7b: GPU transcoding.
#
# GPUs are detected host-side at install time — `devtools/setup-dev.sh` (dev) and
# `install.sh` (prod) enumerate /dev/dri render nodes (Intel QSV / AMD VAAPI) and
# `nvidia-smi` (NVIDIA NVENC) and write the result here as a JSON array. The
# GPU-free backend reads ARM_GPUS to fill the `gpus` table; the dispatcher injects
# the matching device access into each ephemeral transcoder. No overlay, no
# COMPOSE_FILE juggling. Re-run the installer after a GPU/driver change.
#
# Empty array => CPU-only transcoding (zero behavior change). Example populated:
#   ARM_GPUS=[{"vendor":"qsv","device_path":"/dev/dri/renderD128","encoder_kinds":["h264","h265"]}]
ARM_GPUS=[]
#
# GID of the host's /dev/dri render-node group (also detected by the installer).
# The dispatcher adds it to VAAPI/QSV transcoders so the PUID-dropped process can
# open the render node (root:render 0660). Empty => not added (CPU / NVENC-only).
ARM_RENDER_GID=
#
# NVIDIA hosts also need nvidia-container-toolkit so the docker daemon can pass
# GPU device files into the transcoder. install.sh offers to set this up on apt
# hosts; otherwise install it manually and run `sudo nvidia-ctk runtime configure
# --runtime=docker && sudo systemctl restart docker`.
#
# Built-in transcode presets default to `hw_preference=NULL` ("prefer GPU,
# queue if all busy, CPU only if no GPU advertises this codec").

# --- Dispatcher tunables (optional; defaults match the code) ----------------
# How long before an in-flight transcode with no heartbeat is considered stale
# and requeued (seconds).
ARM_TRANSCODE_STALE_THRESHOLD_SECONDS=90
# Max transcode attempts before a task is marked failed.
ARM_TRANSCODE_MAX_ATTEMPTS=3
# How often the backend sweeps the transcode queue (seconds).
ARM_TRANSCODE_DISPATCH_INTERVAL_SECONDS=5
# Remote transcode offload (optional). Set ARM_TRANSCODE_DOCKER_HOST to an
# ssh:// docker endpoint (e.g. ssh://sam@transcoder-server) to spawn transcode
# containers on a remote GPU host instead of the local socket; empty = local.
# ARM_TRANSCODE_BACKEND_URL is the routable backend URL injected into a
# remote-spawned transcoder (e.g. https://192.168.0.68:8080); empty keeps the
# in-network https://arm-backend:8443.
#ARM_TRANSCODE_DOCKER_HOST=
#ARM_TRANSCODE_BACKEND_URL=
# PUID/PGID the spawned transcoder drops to (empty = the image default). Set
# these when the media export is owned by a uid/gid other than the backend's
# PUID — e.g. a remote NFS share owned by a specific NAS user — so the
# transcoder writes as that owner and the entrypoint's chown doesn't revert it.
#ARM_TRANSCODE_PUID=
#ARM_TRANSCODE_PGID=
# Host dir mounted into the backend at /home/arm/.ssh so it can reach the
# remote docker daemon. install.sh sets this to ./ssh when offload is enabled;
# leave unset for local transcoding.
# NOTE: this env var alone does nothing on a hand-copied compose file — only
# install.sh splices the matching `./ssh:/home/arm/.ssh:ro` volume mount onto
# arm-backend in docker-compose.yml. If you copy this template by hand and set
# the ARM_TRANSCODE_* offload keys yourself, you must also add that mount
# yourself or ssh transport to the remote docker daemon has no key to use.
#ARM_TRANSCODE_SSH_DIR=
# Trust model: remote offload is meant for a trusted LAN/homelab. The
# dedicated ssh key install.sh generates is passphraseless (-N "") so the
# backend can use it unattended — anyone who can read the ssh dir (or the
# backend's ssh volume) gets docker-daemon-root on the transcode host. Keep
# the export/dir permissions tight (700/600, as install.sh sets them) and
# don't enable this over an untrusted network.
# How often the backend sweeps the notification outbox (seconds).
ARM_NOTIFICATION_DISPATCH_INTERVAL_SECONDS=5
# Public image URL Apprise attaches to notifications (Discord avatar / embed
# thumbnail, etc.). MUST be reachable by the notification service's servers —
# a LAN-only URL won't render. Empty = no image (sender still labelled "ARM").
ARM_NOTIFY_IMAGE_URL=

# --- Ripper tunables (optional; defaults match the code) --------------------
# How often each ripper polls its drive for media changes (seconds).
POLL_INTERVAL_SECONDS=2.0
# Minimum title duration (seconds) for a track to count as a feature.
ARM_MIN_LENGTH_SECONDS=120
# Tier-4: how often the ripper re-probes makemkv key validity (seconds; daily
# default). Lower it for hourly probes, raise it for weekly.
#MAKEMKV_KEYCHECK_INTERVAL_SECONDS=86400
# Tier-4: consecutive NOT_READY drive polls before re-arming insert detection.
# Flaky USB-BD drives may need a wider window than cheap optical drives.
#ARM_NOT_READY_REARM_POLLS=3

# --- Advanced / container-internal (only change if you know why) ------------
# These default to container-internal paths/bind settings; the stack works
# without setting them. Uncomment to override.
#BIND_HOST=0.0.0.0
#BIND_PORT=8443
#MEDIA_ROOT=/media
#RAW_ROOT=/raw
#ISO_INGRESS_ROOT=/ingress
#ARM_IMAGE_CACHE_PATH=/data/cache/images
#ARM_THEDISCDB_PATH=/data/cache/thediscdb
#ARM_THEMES_PATH=/data/themes
#TLS_CERT_PATH=/etc/ssl/arm/tls.crt
#TLS_KEY_PATH=/etc/ssl/arm/tls.key
#ARM_TRANSCODE_IMAGE=arm-transcode:latest

# --- Tier-3 air-gap: metadata API base-URL overrides (optional) -------------
# Override to point at an internal mirror or proxy. Defaults (shown) are the
# public endpoints; leave unset/commented for normal internet-connected
# deployments.
#ARM_TMDB_BASE_URL=https://api.themoviedb.org/3
#ARM_OMDB_BASE_URL=https://www.omdbapi.com/
#ARM_TVDB_BASE_URL=https://api4.thetvdb.com/v4
#ARM_MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
#ARM_ARMSERVER_BASE_URL=https://1337server.pythonanywhere.com/api/v1/

# Tier-3: extra hostnames the image-proxy will fetch from, ADDED to the built-in
# allowlist (m.media-amazon.com, image.tmdb.org, images-na.ssl-images-amazon.com,
# coverartarchive.org, ia.media-imdb.com). Comma-separated bare hostnames. Only
# add hosts you trust — the allowlist is the proxy's SSRF guard. Avoid bare IP
# addresses (e.g. 192.168.x.x) unless you understand the SSRF implications; an
# entry with a scheme/path (https://host/...) silently never matches and is inert.
#ARM_EXTRA_IMAGE_HOSTS=posters.example.lan

# --- Tier-4: image-proxy disk-cache caps (optional; defaults shown) ----------
# Homelab installs rarely need to change these; large multi-user installs may
# want higher limits. Defaults match the former hardcoded constants.
#ARM_IMAGE_CACHE_MAX_ENTRIES=1000   # max number of cached poster images
#ARM_IMAGE_CACHE_MAX_BYTES=2097152  # 2 MB per-entry byte cap
#ARM_IMAGE_CACHE_TTL_SECONDS=604800 # 7 days

# --- Tier-4: log query/zip caps (optional; defaults shown) -------------------
# ARM_LOG_PER_FILE_DEFAULT — lines returned by GET /api/logs/{job_id} when no
#   ?limit= is supplied. Raise on large deployments with verbose logging.
# ARM_LOG_PER_FILE_HARD_CAP — hard ceiling the endpoint enforces regardless of
#   what the caller requests. Protects backend memory on huge log files.
# ARM_LOG_ZIP_PER_ENTRY_LINE_CAP / _BYTE_CAP — per-file caps applied when
#   building the bug-report zip. Whichever limit is hit first wins.
#ARM_LOG_PER_FILE_DEFAULT=1000
#ARM_LOG_PER_FILE_HARD_CAP=10000
#ARM_LOG_ZIP_PER_ENTRY_LINE_CAP=5000
#ARM_LOG_ZIP_PER_ENTRY_BYTE_CAP=5242880  # 5 MB
